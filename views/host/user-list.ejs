<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>All Users</title>
    <!-- ✅ Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body>
    <%- include('../partials/navbar') %>
    <section class="py-4">
      <div class="container">
        <div class="row mb-3">
          <h1 class="text-center">All Registered Users</h1>
        </div>

        <div class="table-responsive">
          <table class="table table-bordered table-striped align-middle">
            <thead class="table-dark text-center">
              <tr>
                <th>Image</th>
                <th>Full Name</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Role</th>
                <th>Society Name</th>
                <th>Area</th>
                <th>City</th>
                <th>State</th>
                <th>Postal Code</th>
                <th>Date</th>
                <th>Edit</th>
              </tr>
            </thead>
            <tbody class="text-center">
              <% registereUsers.forEach(user => { %>
              <tr>
                <td>
                  <% if (user.image && user.image !== "NA") { %>
                  <img
                    src="<%= user.image %>"
                    alt="User Image"
                    width="50"
                    height="50"
                    class="rounded-circle"
                  />
                  <% } else { %>
                  <img
                    src="https://via.placeholder.com/50?text=NA"
                    alt="No Image"
                    width="50"
                    height="50"
                    class="rounded-circle"
                  />
                  <% } %>
                </td>
                <td><%= user.fullName %></td>
                <td><%= user.phoneNo %></td>
                <td><%= user.email || "NA" %></td>
                <td><%= user.role %></td>
                <td><%= user.societyName || "NA" %></td>
                <td><%= user.area || "NA" %></td>
                <td><%= user.city || "NA" %></td>
                <td><%= user.state || "NA" %></td>
                <td><%= user.postalCode || "NA" %></td>
                <td>
                  <%= new Date(user.createdAt).toLocaleString('en-IN', {
                  timeZone: 'Asia/Kolkata' }) %>
                </td>
                <td>
                  <a
                    href="/host/edit-signup/<%= user._id %>"
                    class="btn btn-sm btn-warning"
                    >Edit</a
                  >
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </body>
  <!-- ✅ Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</html>
